# ---------- Django ----------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=请替换为随机生成的密钥
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- 数据库（改成 sqlite 即降级）----------
DB_ENGINE=django.db.backends.mysql
DB_NAME=oa_system
DB_USER=root
DB_PASSWORD=请填写你的数据库密码
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_oa_system

# ---------- 缓存（redis / locmem / file）----------
CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 异步任务（redis / filesystem）----------
CELERY_BROKER_BACKEND=redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# ---------- 安全 ----------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_MINUTES=15

# ---------- 其它 ----------
CORS_ALLOW_ALL_ORIGINS=True
LOG_LEVEL=INFO
